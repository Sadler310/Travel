<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Travel Budget Planner</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #f3f4f6; }
        @media print {
            .no-print { display: none !important; }
            .shadow-md { box-shadow: none !important; }
            body { background-color: white; }
        }
    </style>
</head>
<body class="text-gray-800">
    <div id="app" class="max-w-4xl mx-auto p-4 md:p-8">
        
        <!-- Header Actions -->
        <div class="flex justify-between items-center mb-6 no-print">
            <h1 class="text-3xl font-bold text-indigo-600"><i class="fa-solid fa-plane-departure mr-2"></i>Бюджет поездки</h1>
            <button @click="exportPDF" class="bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2 px-4 rounded-lg shadow transition">
                <i class="fa-solid fa-file-pdf mr-2"></i>Сохранить в PDF
            </button>
        </div>

        <!-- Export Area (Content that goes to PDF) -->
        <div id="export-area" class="bg-white rounded-xl shadow-md p-6 md:p-10 mb-8">
            
            <!-- Global Trip Info -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8 border-b pb-8">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Название поездки</label>
                    <input v-model="tripName" type="text" class="w-full border-gray-300 rounded-md shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-lg font-semibold p-2 border" placeholder="Евротур 2026">
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Даты</label>
                        <input v-model="dates" type="text" class="w-full border-gray-300 rounded-md shadow-sm p-2 border focus:border-indigo-500" placeholder="10.10 - 25.10">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Валюта</label>
                        <select v-model="currency" class="w-full border-gray-300 rounded-md shadow-sm p-2 border focus:border-indigo-500 bg-white">
                            <option value="₽">RUB (₽)</option>
                            <option value="$">USD ($)</option>
                            <option value="€">EUR (€)</option>
                            <option value="¥">CNY (¥)</option>
                            <option value="฿">THB (฿)</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- Destinations -->
            <div v-for="(dest, index) in destinations" :key="dest.id" class="mb-10 bg-gray-50 rounded-lg p-6 border border-gray-100">
                <div class="flex justify-between items-start mb-4">
                    <div class="w-full md:w-2/3">
                        <input v-model="dest.name" type="text" class="w-full border-transparent bg-transparent rounded-md text-2xl font-bold text-gray-800 placeholder-gray-400 focus:border-indigo-500 focus:bg-white focus:ring-1 focus:ring-indigo-500 p-2 -ml-2 transition" placeholder="Город или Страна (напр. Париж)">
                        <input v-model="dest.dates" type="text" class="w-full md:w-1/2 mt-2 border-transparent bg-transparent rounded-md text-sm text-gray-500 placeholder-gray-400 focus:border-indigo-500 focus:bg-white p-2 -ml-2 transition" placeholder="Даты пребывания">
                    </div>
                    <button @click="removeDestination(dest.id)" class="text-red-400 hover:text-red-600 p-2 no-print" title="Удалить направление">
                        <i class="fa-solid fa-trash"></i>
                    </button>
                </div>

                <!-- Map Integration -->
                <div class="mb-6 rounded-lg overflow-hidden border border-gray-200 shadow-sm" v-if="dest.name.length > 2">
                    <iframe :src="`https://maps.google.com/maps?q=${encodeURIComponent(dest.name)}&t=&z=11&ie=UTF8&iwloc=&output=embed`" width="100%" height="200" frameborder="0" style="border:0" allowfullscreen></iframe>
                </div>

                <!-- Expenses for Destination -->
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm text-gray-600 mb-4">
                        <thead class="text-xs text-gray-700 uppercase bg-gray-200 rounded-t-md">
                            <tr>
                                <th scope="col" class="px-4 py-3 rounded-tl-md">Статья расхода</th>
                                <th scope="col" class="px-4 py-3">Категория</th>
                                <th scope="col" class="px-4 py-3 w-32">Сумма</th>
                                <th scope="col" class="px-4 py-3 w-10 no-print rounded-tr-md"></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr v-for="expense in dest.expenses" :key="expense.id" class="border-b bg-white">
                                <td class="px-4 py-2">
                                    <input v-model="expense.name" type="text" class="w-full border-gray-200 rounded p-1 text-sm focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500" placeholder="Название (напр. Отель Hilton)">
                                </td>
                                <td class="px-4 py-2">
                                    <div class="flex items-center space-x-2">
                                        <select v-if="!expense.isCustomCategory" v-model="expense.category" class="w-full border-gray-200 rounded p-1 text-sm focus:border-indigo-500 bg-white">
                                            <option>Жилье</option>
                                            <option>Транспорт</option>
                                            <option>Еда и рестораны</option>
                                            <option>Виза / Документы</option>
                                            <option>Шоппинг</option>
                                            <option>Экскурсии / Личные</option>
                                        </select>
                                        <input v-else v-model="expense.category" type="text" class="w-full border-gray-200 rounded p-1 text-sm focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500" placeholder="Своя категория">
                                        <button @click="expense.isCustomCategory = !expense.isCustomCategory" class="text-gray-400 hover:text-indigo-600 text-xs no-print" title="Своя категория">
                                            <i class="fa-solid fa-pen"></i>
                                        </button>
                                    </div>
                                </td>
                                <td class="px-4 py-2 flex items-center">
                                    <input v-model.number="expense.amount" type="number" min="0" class="w-full border-gray-200 rounded p-1 text-sm focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 text-right">
                                    <span class="ml-2 font-medium">{{ currency }}</span>
                                </td>
                                <td class="px-4 py-2 no-print text-center">
                                    <button @click="removeExpense(dest.id, expense.id)" class="text-gray-400 hover:text-red-500">
                                        <i class="fa-solid fa-xmark"></i>
                                    </button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="flex justify-between items-center mt-2">
                    <button @click="addExpense(dest.id)" class="text-indigo-600 hover:text-indigo-800 text-sm font-medium no-print">
                        <i class="fa-solid fa-plus mr-1"></i> Добавить расход
                    </button>
                    <div class="text-sm font-semibold text-gray-700">
                        Итого по направлению: {{ destTotal(dest) }} {{ currency }}
                    </div>
                </div>
            </div>

            <!-- Add Destination Button -->
            <button @click="addDestination" class="w-full py-4 border-2 border-dashed border-gray-300 rounded-lg text-gray-500 hover:text-indigo-600 hover:border-indigo-600 hover:bg-indigo-50 transition no-print flex items-center justify-center font-medium">
                <i class="fa-solid fa-map-location-dot mr-2"></i> Добавить новое направление
            </button>

            <!-- Grand Total -->
            <div class="mt-10 p-6 bg-indigo-50 rounded-xl border border-indigo-100 flex justify-between items-center">
                <h2 class="text-2xl font-bold text-gray-800">Общий бюджет</h2>
                <div class="text-3xl font-extrabold text-indigo-700">
                    {{ grandTotal }} {{ currency }}
                </div>
            </div>

        </div>
    </div>

    <script>
        const { createApp, ref, computed } = Vue;

        createApp({
            setup() {
                const tripName = ref('');
                const dates = ref('');
                const currency = ref('$');
                const destinations = ref([
                    {
                        id: 1,
                        name: '',
                        dates: '',
                        expenses: [
                            { id: 101, name: '', category: 'Виза / Документы', amount: null, isCustomCategory: false },
                            { id: 102, name: '', category: 'Жилье', amount: null, isCustomCategory: false }
                        ]
                    }
                ]);

                const addDestination = () => {
                    destinations.value.push({
                        id: Date.now(),
                        name: '',
                        dates: '',
                        expenses: [
                            { id: Date.now() + 1, name: '', category: 'Жилье', amount: null, isCustomCategory: false }
                        ]
                    });
                };

                const removeDestination = (id) => {
                    destinations.value = destinations.value.filter(d => d.id !== id);
                };

                const addExpense = (destId) => {
                    const dest = destinations.value.find(d => d.id === destId);
                    if (dest) {
                        dest.expenses.push({ id: Date.now(), name: '', category: 'Еда и рестораны', amount: null, isCustomCategory: false });
                    }
                };

                const removeExpense = (destId, expId) => {
                    const dest = destinations.value.find(d => d.id === destId);
                    if (dest) {
                        dest.expenses = dest.expenses.filter(e => e.id !== expId);
                    }
                };

                const destTotal = (dest) => {
                    return dest.expenses.reduce((sum, exp) => sum + (exp.amount || 0), 0).toLocaleString();
                };

                const grandTotal = computed(() => {
                    const total = destinations.value.reduce((sum, dest) => {
                        return sum + dest.expenses.reduce((s, exp) => s + (exp.amount || 0), 0);
                    }, 0);
                    return total.toLocaleString();
                });

                const exportPDF = () => {
                    const element = document.getElementById('export-area');
                    const opt = {
                        margin:       0.5,
                        filename:     'travel_budget.pdf',
                        image:        { type: 'jpeg', quality: 0.98 },
                        html2canvas:  { scale: 2, useCORS: true },
                        jsPDF:        { unit: 'in', format: 'a4', orientation: 'portrait' }
                    };
                    html2pdf().set(opt).from(element).save();
                };

                return {
                    tripName, dates, currency, destinations,
                    addDestination, removeDestination, addExpense, removeExpense,
                    destTotal, grandTotal, exportPDF
                };
            }
        }).mount('#app');
    </script>
</body>
</html>
